# SSH port forwards (same port both ends): fip starts, dip stops, lip lists
fip() {
  (( $# < 2 )) && echo "Usage: fip <host> <port1> [port2] ..." && return 1
  local host="$1" port
  shift
  for port in "$@"; do
    ssh -f -N -L "${port}:localhost:${port}" "$host" && echo "Forwarding localhost:$port -> $host:$port"
  done
}
dip() {
  (( $# == 0 )) && echo "Usage: dip <port1> [port2] ..." && return 1
  local port
  for port in "$@"; do
    pkill -f "ssh.*-L ${port}:localhost:${port}" && echo "Stopped forwarding port $port" || echo "No forwarding on port $port"
  done
}
# ps + grep, not `pgrep -af`: macOS pgrep's -a means "ancestors" and prints bare PIDs
lip() { ps -axo pid=,args= | command grep -E "[s]sh.*-L [0-9]+:localhost:[0-9]+" || echo "No active forwards"; }

