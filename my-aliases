# CLEAN UP (asks first; only Caches and Logs)
mac-cleanup() {
  print -n "Delete contents of ~/Library/Caches and ~/Library/Logs? [y/N] "
  if read -q; then
    print
    rm -rf ~/Library/Caches/* ~/Library/Logs/*
  else
    print
    print "aborted"
  fi
}

