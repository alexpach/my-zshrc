# PATH
typeset -gU path
path=(
  $HOME/{,s}bin(N)
  $HOME/.local/bin
  $HOME/.lmstudio/bin
  /opt/{homebrew,local}/{,s}bin(N)
  /usr/local/{,s}bin(N)
  $path
)

# Environment
[[ -z "$EDITOR" ]]   && export EDITOR='vim'
[[ -z "$VISUAL" ]]   && export VISUAL='vim'
[[ -z "$PAGER" ]]    && export PAGER='less'
[[ -z "$LANG" ]]     && export LANG='en_US.UTF-8'
[[ -z "$LESS" ]]     && export LESS='-g -i -M -R -S -w -X -z-4'
[[ "$OSTYPE" == darwin* && -z "$BROWSER" ]] && export BROWSER='open'
export HOMEBREW_NO_ENV_HINTS=1

# History
HISTFILE="$HOME/.zsh_history"
HISTSIZE=10000
SAVEHIST=10000
setopt BANG_HIST EXTENDED_HISTORY SHARE_HISTORY
setopt HIST_EXPIRE_DUPS_FIRST HIST_IGNORE_DUPS HIST_IGNORE_ALL_DUPS
setopt HIST_FIND_NO_DUPS HIST_IGNORE_SPACE HIST_SAVE_NO_DUPS HIST_VERIFY

# Directory
setopt AUTO_CD AUTO_PUSHD PUSHD_IGNORE_DUPS PUSHD_SILENT

# Completion
autoload -Uz compinit && compinit
setopt COMPLETE_IN_WORD ALWAYS_TO_END PATH_DIRS AUTO_MENU

# Colors
autoload -Uz colors && colors

# Key bindings (emacs)
bindkey -e
autoload -Uz up-line-or-beginning-search down-line-or-beginning-search
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search
bindkey '^[[A' up-line-or-beginning-search   # up arrow
bindkey '^[[B' down-line-or-beginning-search # down arrow
bindkey '^[OA' up-line-or-beginning-search   # up arrow (alt)
bindkey '^[OB' down-line-or-beginning-search # down arrow (alt)

# ls colors
if [[ "$OSTYPE" == darwin* ]]; then
  export CLICOLOR=1
else
  alias ls='ls --color=auto'
fi

# Prompt: user@host path [exit code] %
autoload -Uz promptinit && promptinit
setopt PROMPT_SUBST
_prompt_precmd() {
  local exit_code=$?
  local code_indicator=""
  [[ $exit_code -ne 0 ]] && code_indicator=" %F{red}$exit_code%f"
  PROMPT="%F{cyan}%n@%m%f:%F{blue}%~%f${code_indicator} %# "
}
add-zsh-hook precmd _prompt_precmd

# Terminal title
add-zsh-hook precmd  _title_precmd
add-zsh-hook preexec _title_preexec
_title_precmd()  { print -Pn '\e]0;%n@%m: %~\a' }
_title_preexec() { print -n "\e]0;${1}\a" }

# aliases
[ -f ~/.my-aliases ] && source ~/.my-aliases

# private config (managed by chezmoi, not in git)
[ -f ~/.my-private ] && source ~/.my-private

# zoxide (cd replacement)
(( $+commands[zoxide] )) && eval "$(zoxide init zsh)"

# fzf fuzzy search
[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh

# NVM - lazy load
export NVM_DIR="$HOME/.nvm"
_load_nvm() {
  unset -f nvm node npm npx _load_nvm
  [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
  [ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"
}
nvm()  { _load_nvm; nvm  "$@"; }
node() { _load_nvm; node "$@"; }
npm()  { _load_nvm; npm  "$@"; }
npx()  { _load_nvm; npx  "$@"; }
